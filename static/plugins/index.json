{
  "v": 1,
  "plugins": [
    {
      "id": "habit-heatmap",
      "name": "Heatmap Habit",
      "description": "Grid habit tercentang dan task selesai setahun terakhir di Dashboard.",
      "version": "1.1.0",
      "minApi": 1,
      "slots": [
        "dashboard.widgets"
      ],
      "permissions": [
        "storage"
      ],
      "defaultEnabled": false,
      "files": [
        "plugin.js",
        "style.css"
      ],
      "hash": "aff4ba9b"
    },
    {
      "id": "timeline",
      "name": "Timeline",
      "description": "Gantt untuk project dan workspace: jadwal hari kerja, dependensi, milestone.",
      "version": "1.2.0",
      "minApi": 1,
      "slots": [
        "taskList.views",
        "taskDetail.sections"
      ],
      "permissions": [
        "storage",
        "task.ext",
        "records"
      ],
      "defaultEnabled": false,
      "contributes": {
        "taskList.views": [
          {
            "id": "gantt",
            "label": "Timeline",
            "icon": {
              "path": "M2 4h7M5 8h8M3 12h5"
            },
            "pages": [
              "project",
              "workspace"
            ]
          }
        ],
        "taskDetail.sections": [
          {
            "id": "schedule",
            "label": "Jadwal",
            "order": 10
          }
        ]
      },
      "taskExt": {
        "keys": [
          "start",
          "duration",
          "deps",
          "mode",
          "constraint",
          "actual"
        ]
      },
      "records": {
        "calendar": {
          "conflict": "lww",
          "maxBytes": 16384
        },
        "project": {
          "conflict": "lww",
          "maxBytes": 1024
        },
        "baseline": {
          "conflict": "lww",
          "maxBytes": 65536
        }
      },
      "files": [
        "plugin.js",
        "style.css"
      ],
      "hash": "60f014b3"
    }
  ]
}
