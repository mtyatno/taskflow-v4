# ╔══════════════════════════════════════════════════════╗
# ║         Alurik — Configuration                      ║
# ╚══════════════════════════════════════════════════════╝

# Telegram Bot Token (dapatkan dari @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Kosongkan untuk allow semua user
# Cara cek ID: kirim pesan ke @userinfobot
ALLOWED_USER_IDS=123456789

# Path database SQLite (default: ./taskflow.db)
DB_PATH=./taskflow.db

# Interval recalculate Eisenhower quadrant (menit)
EISENHOWER_INTERVAL_MINUTES=15

# Timezone
TIMEZONE=Asia/Jakarta

# SMTP — email transaksional (reset password).
# Kosongkan SMTP_HOST untuk dev mode: email tidak dikirim, isinya dicetak ke log server.
# SMTP_SECURITY: starttls | ssl | none. Kosong = ditebak dari port (465 = ssl, lainnya starttls).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alurik <noreply@example.com>
SMTP_SECURITY=
SMTP_REPLY_TO=
SMTP_TIMEOUT=15
# Contoh Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Contoh Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=resend
# Contoh Exim lokal:
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_SECURITY=starttls
