# ╔══════════════════════════════════════════════════════╗
# ║         Alurik — Configuration                      ║
# ╚══════════════════════════════════════════════════════╝

# Telegram Bot Token (dapatkan dari @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Kosongkan untuk allow semua user
# Cara cek ID: kirim pesan ke @userinfobot
ALLOWED_USER_IDS=123456789

# Path database SQLite (default: ./taskflow.db)
DB_PATH=./taskflow.db

# Interval recalculate Eisenhower quadrant (menit)
EISENHOWER_INTERVAL_MINUTES=15

# Timezone
TIMEZONE=Asia/Jakarta

# SMTP — email transaksional (reset password).
# Kosongkan SMTP_HOST untuk dev mode: email tidak dikirim, isinya dicetak ke log server.
# SMTP_SECURITY: starttls | ssl | none. Kosong = ditebak dari port (465 = ssl, lainnya starttls).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alurik <noreply@example.com>
SMTP_SECURITY=
SMTP_REPLY_TO=
SMTP_TIMEOUT=15
# Contoh Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Contoh Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=resend
# Contoh Exim di server sendiri:
# SMTP_HOST=mail.yatno.web.id   # pakai hostname yang ada di sertifikat mail server (bukan localhost)
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Pengiriman lokal tanpa TLS: SMTP_HOST=localhost, SMTP_PORT=25, SMTP_SECURITY=none

# ── Domain & CORS ──
# Alamat publik Alurik; dipakai untuk tautan magic login Telegram, reset password, undangan workspace, dan note publik.
# WEBAPP_URL=https://alurik.com
# Origin yang boleh memanggil API (Tauri Desktop/APK + domain web). Pisahkan dengan koma, tanpa slash di belakang.
# Selama masa transisi domain, sertakan domain lama juga.
# CORS_ALLOW_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://alurik.com,https://todo.yatno.web.id
